# Copy to .env (gitignored). Values reach code only through the environment.
FMP_API_KEY=
# optional — UW features (GEX regime, implied move, presidential posts, live headlines) are skipped if missing
UW_API_KEY=
# optional — only for `--llm` tagging
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

TICKERS=SPY,QQQ
START_DATE=2021-01-01
# END_DATE defaults to today
CACHE_DIR=cache
OUT_DIR=output
# verify once on your account: the zone FMP stamps publishedDate in
FMP_NEWS_TZ=America/New_York
REQUEST_PAUSE=0.25
MAX_NEWS_PAGES=8
GAP_FLAT=0.25
GAP_LARGE=0.75
QUIET_THRESHOLD=3.0
HOLDOUT_FRAC=0.30
MIN_N=15
