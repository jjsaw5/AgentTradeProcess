# Template. Variable NAMES only — never a value. Copy to .env and fill in.
# .env is gitignored; see CLAUDE.md §6.

# Unusual Whales — the edge layer (flow, dealer greeks, tide, IV rank).
# Sent as: Authorization: Bearer $UNUSUAL_WHALES_API_KEY
# plus the mandatory header UW-CLIENT-API-ID: 100001
UNUSUAL_WHALES_API_KEY=

# Financial Modeling Prep — the context layer (bars, quotes, calendars).
# Sent as: ?apikey=$FMP_API_KEY   Use stable/* paths only; v3 is dead.
FMP_API_KEY=

# Robinhood is reached through the Claude Code MCP connector, not an env var.
